{
  "plugin": "org.smartide.plugin.go",
  "run": "go run ./cmd/server",
  "intelligence": {
    ".json": {
      "enabled": true,
      "run": "vscode-json-language-server --stdio"
    },
    ".go": {
      "enabled": true,
      "run": "gopls"
    },
    ".md": {
      "enabled": true,
      "run": "marksman server"
    },
    ".mod": {
      "enabled": true,
      "run": "gopls"
    }
  }
}