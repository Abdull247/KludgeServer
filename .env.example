# development | production
APP_ENV=development

# live | test
# test serves catalog JSON from internal/catalog/mocks and skips Postgres
MODE=live

# HTTP port the API listens on
APP_PORT=8080

# Public URL of this API (used to build OAuth callback URLs)
# Local: http://localhost:8080
# Production: https://api.yourdomain.com
APP_PUBLIC_URL=http://localhost:8080

# Frontend origin allowed for CORS + post-login redirect
# Local: http://localhost:3000
# Production: https://kludgekit.web.app
FRONTEND_URL=https://kludgekit.web.app

# Postgres connection string
# Local dev (this repo's default):
DATABASE_URL=postgres://kludge:kludge_dev@127.0.0.1:5432/kludge?sslmode=disable
# Neon example (production):
# DATABASE_URL=postgres://USER:PASSWORD@HOST/dbname?sslmode=require

# Random 32+ character secret used to sign cookies
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Cookie name for the login session
SESSION_COOKIE=kludge_session

# GitHub OAuth App
# https://github.com/settings/developers
# Authorization callback URL: {APP_PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth Client (type: Web application)
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email of the automation ingest account. Only this identity may POST
# /api/v1/items/record. Leave empty in live mode to disable record ingest.
AUTOMATION_EMAIL=ingest@kludge.dev

# Comma-separated emails that get admin access (/api/v1/admin/* and the
# admin dashboard in the web client).
ADMIN_EMAILS=you@example.com,team@example.com

# Cloudflare R2 (S3-compatible) for artwork, banners, and source files.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Max size for a single source/artwork upload. Accepts bytes or 50MB.
MAX_UPLOAD_BYTES=50MB
