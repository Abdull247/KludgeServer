# development | production
APP_ENV=development

# HTTP port the API listens on
APP_PORT=8080

# Public URL of this API (used to build OAuth callback URLs)
# Local: http://localhost:8080
# Production: https://api.yourdomain.com
APP_PUBLIC_URL=http://localhost:8080

# Frontend origin allowed for CORS + post-login redirect
FRONTEND_URL=http://localhost:3000

# Postgres connection string
# Local dev (this repo's default):
DATABASE_URL=postgres://kludge:kludge_dev@127.0.0.1:5432/kludge?sslmode=disable
# Neon example (production):
# DATABASE_URL=postgres://USER:PASSWORD@HOST/dbname?sslmode=require

# Random 32+ character secret used to sign cookies
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Cookie name for the login session
SESSION_COOKIE=kludge_session

# GitHub OAuth App
# https://github.com/settings/developers
# Authorization callback URL: {APP_PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth Client (type: Web application)
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
